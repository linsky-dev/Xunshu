+pub fn enqueue_changes(dir: &Path, paths: &[PathBuf]) -> Result<usize> {
+    let lock = xs_platform::open_or_create_local_lock(&dir.join(CONTENT_LOCK))?;
+    FileExt::try_lock_exclusive(&lock).context("正文任务正在运行，请稍后重试提交变更")?;
