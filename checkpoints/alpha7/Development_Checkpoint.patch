+    if bytes.len() as u64 > MAX_REQUEST_BYTES {
+        queue.full = true;
+        queue.paths.clear();
+        bytes = serde_json::to_vec(&queue)?;
+    }
+    policy.verify(dir)?;
+    let result = xs_platform::atomic_write_local(&dir.join(CONTENT_REQUESTS), &bytes, true)?;
+    ensure!(result.is_durable(), "变更队列持久化未确认，请重试");
